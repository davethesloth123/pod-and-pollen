# ─────────────────────────────────────────────────────────────
# Pod & Pollen — environment variables
#
# Copy this file to:
#   .env.local          → local dev (points at your "testing" Supabase project)
#
# In Vercel, set variables per environment:
#   Preview (staging branch) → staging Supabase project
#   Production              → production Supabase project
# ─────────────────────────────────────────────────────────────

# Supabase — find these in your project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment label shown in the app header (optional)
# Values: "development" | "staging" | "production"
NEXT_PUBLIC_ENV=development
